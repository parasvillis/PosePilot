    }
  ],
  "testing": {
    "attribute": "testID",
    "convention": "kebab-case, role-based"
  },
  "instructions_to_main_agent": [
    "Use pure dark mode (#000000 base) with #FFD60A for active tracking elements and #32D74B for match-success states.",
    "Camera HUD must be completely transparent to avoid obstructing the viewfinder. Use `rgba(28, 28, 30, 0.7)` with blur for floating controls.",
    "The pose carousel unselected items must scale down (0.9) and drop opacity to 50% to maintain a minimal feel.",
    "Rely exclusively on @expo/vector-icons/Ionicons (no emojis) for UI iconography.",
    "Provide `testID` props for all interactive items (capture button, carousel items, sliders)."
  ]
}